# ---- Godot 4+ ----
# The entire .godot/ folder is regenerated by the editor on open/import (editor cache,
# imported assets, and the Mono build output under .godot/mono/temp). Never commit it.
.godot/

# Godot exports / logs
/build/
export_presets.cfg
*.translation

# ---- .NET / Mono build output ----
[Bb]in/
[Oo]bj/
.mono/
*.user
*.userprefs
mono_crash.*.json

# ---- Claude Code ----
# Version the shareable config (agents/commands/skills, settings.json) so the
# handoff system is durable; ignore only machine-local state + the local override.
.claude/settings.local.json
.claude/*.local.json

# ---- Local MCP config (contains the Meshy API key — never commit) ----
.mcp.json

# ---- AI knowledge-system caches (generated; safe to clear) ----
# Meshy MCP payloads + other cached tool output (.cache/meshy/)
.cache/
# filtered-command full logs (run-filtered.ps1)
artifacts/logs/

# ---- AI visual-test harness artifacts (generated; safe to clear between runs) ----
artifacts/ai/

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
*.tmp
